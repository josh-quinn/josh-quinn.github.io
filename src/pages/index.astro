---
import Base from '../layouts/Base.astro';
import Terminal, { type PlayedStep } from '../components/Terminal.astro';
import term from '../content/terminal.json';
import { createSession, tuiFrames, type Demo, type TermData } from '../lib/terminal';

// Every terminal transcript is printed by the same canned session the live prompt uses
// (src/lib/terminal.ts), run over the fictional content in src/content/terminal.json.
// JSON imports type the fs tree too loosely for its recursive type: cast through unknown.
const data = term as unknown as TermData;
const session = createSession(data);
const play = (demo: Demo): PlayedStep[] => demo.steps.map((s) => ({ ...s, out: session.run(s.cmd, { record: false }) }));
const { whoami, notes, tui, journey } = data.demos;
const tryIt = data.demos.try;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Josh Quinn" description="Personal site. Sample content while it is being built.">
  <aside class="announce" aria-label="Announcement">
    <p>Under construction: everything here is sample content for a fictional persona.</p>
  </aside>
  <div class="page-wide page-story">
    <header class="navbar">
      <a class="navbar-brand" href="/" aria-current="page">Josh Quinn</a>
    </header>
    <main>
      <div class="hero">
        <span class="label reveal">Personal site · sample content</span>
        <h1>Josh Quinn</h1>
        <p class="reveal d2">
          Placeholder. A short CV, notes and the odd project will live here. For now a small
          terminal tells the story, one short loop for each part of the page, and you can type
          into it yourself.
        </p>
        <p class="reveal d3 links"><a class="bracket" href="#colophon">Read the colophon</a></p>
      </div>

      <div class="split story">
        <div class="split-media" style="--row: 1">
          <Terminal
            name="whoami"
            row={1}
            pos="first"
            title={whoami.title}
            label={whoami.label}
            foot={whoami.foot}
            steps={play(whoami)}
          />
        </div>
        <div class="split-prose" data-row="1" style="--row: 1">
          <section class="reveal d4" aria-labelledby="who">
            <span class="label">Who</span>
            <h2 id="who">A sample person, for now</h2>
            <p>
              Placeholder. This page belongs to a fictional persona while the site is built, so the
              roles and places in the terminal are samples. The real ones arrive after a review.
            </p>
          </section>
          <section class="reveal d5" aria-labelledby="now">
            <span class="label">Now</span>
            <h2 id="now">What they are up to</h2>
            <p>
              A sample role at a sample organisation, a sample course in the evenings, and a book
              read one chapter a week. The terminal keeps it in <code>now.txt</code>.
            </p>
          </section>
        </div>

        <div class="split-media" style="--row: 2">
          <Terminal
            name="notes"
            row={2}
            pos="mid"
            title={notes.title}
            label={notes.label}
            foot={notes.foot}
            steps={play(notes)}
          />
        </div>
        <div class="split-prose" data-row="2" style="--row: 2">
          <section aria-labelledby="notes">
            <span class="label">Projects</span>
            <h2 id="notes">A small notes tool</h2>
            <p>
              Placeholder. An example of the kind of project that will live here: a tiny command-line
              tool that adds a note, lists the notes as a table and marks them done. It is fictional,
              and so are its notes.
            </p>
            <p>The terminal runs it in a loop: <code>notes add</code>, then <code>notes ls</code>.</p>
          </section>
        </div>

        <div class="split-media" style="--row: 3">
          <Terminal
            name="tui"
            row={3}
            pos="mid"
            title={tui.title}
            label={tui.label}
            foot={tui.foot}
            steps={play(tui).map((s) => ({ ...s, out: { kind: 'lines' as const, lines: [] } }))}
            frames={tuiFrames(data.tui)}
          />
        </div>
        <div class="split-prose" data-row="3" style="--row: 3">
          <section aria-labelledby="board">
            <span class="label">Projects</span>
            <h2 id="board">The same notes, as a board</h2>
            <p>
              Placeholder. The notes tool also has a small text interface: three columns for todo,
              doing and done, a highlight you move with the arrow keys, and one key to move a note
              along. The terminal plays a short session with it.
            </p>
          </section>
        </div>

        <div class="split-media" style="--row: 4">
          <Terminal
            name="journey"
            row={4}
            pos="last"
            title={journey.title}
            label={journey.label}
            foot={journey.foot}
            steps={play(journey)}
            scenes={data.journey.scenes}
            journey={{ intro: data.journey.intro, outro: data.journey.outro }}
          />
        </div>
        <div class="split-prose" data-row="4" style="--row: 4">
          <section aria-labelledby="journey">
            <span class="label">About</span>
            <h2 id="journey">The journey so far</h2>
            <p>
              Placeholder. A short script prints three small scenes, drawn as pixels in SVG. They are
              generic: a city, some books and a laptop stand in until the real story is written.
            </p>
            <ol class="story-list">
              {data.journey.scenes.map((s, i) => (
                <li>
                  <span class="label">{pad(i + 1)} · {s.title}</span>
                  {s.caption.charAt(0).toUpperCase() + s.caption.slice(1)}.
                </li>
              ))}
            </ol>
          </section>
        </div>
      </div>

      <section class="try" aria-labelledby="try">
        <span class="label">Try it</span>
        <h2 id="try">Type into the terminal</h2>
        <p>Type <code>help</code> for the commands. Every answer is canned, and nothing you type leaves this page.</p>
        <Terminal
          name="try"
          class="t-try"
          title={tryIt.title}
          label={tryIt.label}
          foot={tryIt.foot}
          steps={play(tryIt)}
        />
      </section>

      <section class="colophon" aria-labelledby="colophon">
        <span class="label">Colophon</span>
        <h2 id="colophon">How it is made</h2>
        <p>
          Static pages, one serif and two monos, set on paper drawn in CSS. The terminal's loops are
          CSS and stop when you ask for reduced motion. One small script starts the loop for the part
          you are reading and lets you type into it; without the script, the transcripts above are
          the whole page.
        </p>
        <dl class="facts">
          <dt>Type</dt>
          <dd>Newsreader, Departure Mono, Commit Mono</dd>
          <dt>Paper</dt>
          <dd>Drawn in CSS</dd>
          <dt>Scripts</dt>
          <dd>One, for the terminal on this page</dd>
        </dl>
      </section>
    </main>
  </div>
  <script>
    import '../scripts/terminal.ts';
  </script>
</Base>
